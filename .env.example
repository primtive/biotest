# Production: скопируйте в .env и замените примерные значения.
SITE_ADDRESS=https://bio.example.com
# Для запуска Next.js без Compose; в compose.yml берётся из SITE_ADDRESS.
NEXTAUTH_URL=https://bio.example.com

# Внешняя MongoDB с replica set, доступная из контейнера приложения.
# Логин и пароль в URI должны быть URL-encoded.
DATABASE_URL="mongodb://biotest:replace-me@mongo.example.com:27017/biotest?authSource=biotest&replicaSet=rs0&directConnection=true"

# Обязательно задайте случайный секрет: openssl rand -hex 32
NEXTAUTH_SECRET=

# Для npm run dev:local задайте в .env.local:
# NEXTAUTH_URL=http://localhost:3001
# DATABASE_URL="mongodb://127.0.0.1:27018/biotest?replicaSet=rs0&directConnection=true"
