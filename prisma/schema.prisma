// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["linux-musl-openssl-3.0.x", "native"]
  // output   = "../generated"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String              @id @default(auto()) @map("_id") @db.ObjectId
  createdAt     DateTime            @default(now())
  lastAccess    DateTime            @default(now())
  username      String              @unique
  name          String              @unique
  admin         Boolean             @default(false)
  password      String?
  group         String              @default("")
  scores        score[]
  score         Int                 @default(0)
  testsCount    Int                 @default(0)
  percent       Int                 @default(0)
  isArchive     Boolean             @default(false)
  tests         Test[]
  topicGroup    TopicGroup          @relation(fields: [topicGroupId], references: [id])
  topicGroupId  String              @db.ObjectId
  topicProgress UserTopicProgress[]
}

model Test {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  createdAt    DateTime   @default(now())
  completedAt  DateTime?
  answers      answer[]
  isComplete   Boolean    @default(false)
  tasksIds     String[]   @db.ObjectId
  tasks        Task[]     @relation(fields: [tasksIds], references: [id])
  user         User       @relation(fields: [userId], references: [id])
  userId       String     @db.ObjectId
  topicGroup   TopicGroup @relation(fields: [topicGroupId], references: [id])
  topicGroupId String     @db.ObjectId
  // topicsId    String[]  @default([]) @db.ObjectId
  // topics      Topic[]   @relation(fields: [topicsId], references: [id])
}

model Task {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  html        String
  answer      String
  line        String   @default("")
  isReported  Boolean  @default(false)
  source      String   @default("")
  explanation String   @default("")
  active      Boolean  @default(true)
  disordered  Boolean  @default(false)
  topic       Topic    @relation(fields: [topicId], references: [id])
  topicId     String   @db.ObjectId
  testIDs     String[] @default([]) @db.ObjectId
  tests       Test[]   @relation(fields: [testIDs], references: [id])
}

model TopicGroup {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  name   String
  topics Topic[]
  User   User[]
  Test   Test[]
}

model Topic {
  id           String              @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  active       Boolean             @default(true)
  section      String              @default("")
  topicGroup   TopicGroup          @relation(fields: [topicGroupId], references: [id])
  topicGroupId String              @db.ObjectId
  Task         Task[]
  userProgress UserTopicProgress[]
}

model UserTopicProgress {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  user           User     @relation(fields: [userId], references: [id])
  userId         String   @db.ObjectId
  topic          Topic    @relation(fields: [topicId], references: [id])
  topicId        String   @db.ObjectId
  percent        Float    @default(0) // Percentage 0-100
  updatedAt      DateTime @updatedAt
  correctTaskIds String[] @db.ObjectId

  @@unique([userId, topicId])
}

type score {
  score     Int
  createdAt DateTime
  testId    String
}

type answer {
  taskId  String  @db.ObjectId
  answer  String
  correct Boolean
}
