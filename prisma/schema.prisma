// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["darwin-arm64", "native", "linux-musl-arm64-openssl-3.0.x"]
  // output   = "../generated"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String              @id @default(auto()) @map("_id") @db.ObjectId
  createdAt     DateTime            @default(now())
  lastAccess    DateTime            @default(now())
  username      String              @unique
  name          String
  admin         Boolean             @default(false)
  group         String              @default("")
  scores        score[]
  score         Float               @default(0)
  testsCount    Int                 @default(0)
  percent       Int                 @default(0)
  isArchive     Boolean             @default(false)
  tests         Test[]
  topicGroup    TopicGroup          @relation(fields: [topicGroupId], references: [id])
  topicGroupId  String              @db.ObjectId
  topicProgress UserTopicProgress[]
}

model Test {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  createdAt    DateTime   @default(now())
  completedAt  DateTime?
  answers      answer[]
  isComplete   Boolean    @default(false)
  tasksIds     String[]   @db.ObjectId
  tasks        Task[]     @relation(fields: [tasksIds], references: [id])
  user         User       @relation(fields: [userId], references: [id])
  userId       String     @db.ObjectId
  topicGroup   TopicGroup @relation(fields: [topicGroupId], references: [id])
  topicGroupId String     @db.ObjectId
  taskCount    Int?
  answeredCount Int?
  correctCount Int?
  snapshots    TaskSnapshot[]
  snapshotSource String @default("recorded")

  @@index([userId, createdAt])
  @@index([userId, isComplete, completedAt])
  @@index([topicGroupId, completedAt])
  @@index([tasksIds])
}

model Task {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  html        String
  answer      String
  line        String   @default("")
  isReported  Boolean  @default(false)
  source      String   @default("")
  explanation String   @default("")
  active      Boolean  @default(true)
  disordered  Boolean  @default(false)
  topic       Topic    @relation(fields: [topicId], references: [id])
  topicId     String   @db.ObjectId
  testIDs     String[] @default([]) @db.ObjectId
  tests       Test[]   @relation(fields: [testIDs], references: [id])

  @@index([topicId, active, isReported])
}

model TopicGroup {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  name   String
  topics Topic[]
  User   User[]
  Test   Test[]
}

model Topic {
  id           String              @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  active       Boolean             @default(true)
  section      String              @default("")
  topicGroup   TopicGroup          @relation(fields: [topicGroupId], references: [id])
  topicGroupId String              @db.ObjectId
  Task         Task[]
  userProgress UserTopicProgress[]

  @@index([topicGroupId, active])
}

model UserTopicProgress {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  user           User     @relation(fields: [userId], references: [id])
  userId         String   @db.ObjectId
  topic          Topic    @relation(fields: [topicId], references: [id])
  topicId        String   @db.ObjectId
  percent        Float    @default(0) // Percentage 0-100
  updatedAt      DateTime @updatedAt
  correctTaskIds String[] @db.ObjectId
  version        Int?

  @@unique([userId, topicId])
}

type score {
  score     Float
  createdAt DateTime
  testId    String
}

type answer {
  taskId  String  @db.ObjectId
  answer  String
  correct Boolean
}

type TaskSnapshot {
  taskId String @db.ObjectId
  topicId String @db.ObjectId
  topicName String
  html String
  answer String
  explanation String
  line String
  source String
  disordered Boolean
  missing Boolean @default(false)
}

// Materialized statistics. MongoDB collection keys encode scope, group and academic year.
model StatisticsCache {
  id String @id @map("_id")
  period String
  userId String?
  topicGroupId String?
  revision Int
  updatedAt DateTime
  data Json
  @@index([updatedAt])
}

model StatisticsRevision {
  id String @id @map("_id")
  revision Int
  updatedAt DateTime
}
